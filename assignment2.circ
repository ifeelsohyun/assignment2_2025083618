  <vhdl appearance="logisim_evolution" name="and_or4">library ieee;
use ieee.std_logic_1164.all;

entity and_or4 is
    port (
        a, b, c, d : in std_logic;
        out1, out2 : out std_logic
    );
end entity and_or4;

architecture bhv of and_or4 is
begin
    out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="mux8_1">library ieee;
use ieee.std_logic_1164.all;

entity mux8_1 is
    port (
        d    : in  std_logic_vector(7 downto 0);
        ch   : in  std_logic_vector(2 downto 0);
        data : out std_logic
    );
end entity mux8_1;

architecture bhv of mux8_1 is
begin
    process(d, ch)
    begin
        case ch is
            when "000" =&gt; data &lt;= d(0);
            when "001" =&gt; data &lt;= d(1);
            when "010" =&gt; data &lt;= d(2);
            when "011" =&gt; data &lt;= d(3);
            when "100" =&gt; data &lt;= d(4);
            when "101" =&gt; data &lt;= d(5);
            when "110" =&gt; data &lt;= d(6);
            when "111" =&gt; data &lt;= d(7);
            when others =&gt; data &lt;= '0';
        end case;
    end process;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="letters">library ieee;
use ieee.std_logic_1164.all;

entity letters is
    port (
        sel     : in  std_logic_vector(2 downto 0);
        display : out std_logic_vector(7 downto 0)
    );
end entity letters;

architecture bhv of letters is
begin
    process(sel)
    begin
        case sel is
            when "000" =&gt; display &lt;= "11101110"; -- A
            when "001" =&gt; display &lt;= "00111110"; -- b
            when "010" =&gt; display &lt;= "10011100"; -- C
            when "011" =&gt; display &lt;= "01111010"; -- d
            when "100" =&gt; display &lt;= "10001110"; -- F
            when "101" =&gt; display &lt;= "11110110"; -- G
            when others =&gt; display &lt;= "00000000";
        end case;
    end process;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="vote25">library ieee;
use ieee.std_logic_1164.all;

entity vote25 is
    port (
        vt     : in  std_logic_vector(25 downto 1);
        result : out std_logic
    );
end entity vote25;

architecture bhv of vote25 is
begin
    process(vt)
        variable sum : integer range 0 to 25;
    begin
        sum := 0;
        for i in 1 to 25 loop
            if vt(i) = '1' then
                sum := sum + 1;
            end if;
        end loop;
        if sum &gt;= 13 then
            result &lt;= '1';
        else
            result &lt;= '0';
        end if;
    end process;
end architecture bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="count_led">library ieee;
use ieee.std_logic_1164.all;

entity count_led is
    port (
        en      : in  std_logic;
        vt      : in  std_logic_vector(15 downto 1);
        display : out std_logic_vector(7 downto 0)
    );
end entity count_led;

architecture bhv of count_led is
begin
    process(en, vt)
        variable sum : integer range 0 to 15;
    begin
        sum := 0;
        for i in 1 to 15 loop
            if vt(i) = '1' then
                sum := sum + 1;
            end if;
        end loop;

        if en = '0' then
            display &lt;= "00000000";
        else
            case sum is
                when 0  =&gt; display &lt;= "11111100";
                when 1  =&gt; display &lt;= "01100000";
                when 2  =&gt; display &lt;= "11011010";
                when 3  =&gt; display &lt;= "11110010";
                when 4  =&gt; display &lt;= "01100110";
                when 5  =&gt; display &lt;= "10110110";
                when 6  =&gt; display &lt;= "10111110";
                when 7  =&gt; display &lt;= "11100000";
                when 8  =&gt; display &lt;= "11111110";
                when 9  =&gt; display &lt;= "11100110";
                when 10 =&gt; display &lt;= "11101110"; -- A
                when 11 =&gt; display &lt;= "00111110"; -- b
                when 12 =&gt; display &lt;= "10011100"; -- C
                when 13 =&gt; display &lt;= "01111010"; -- d
                when 14 =&gt; display &lt;= "10011110"; -- E
                when 15 =&gt; display &lt;= "10001110"; -- F
                when others =&gt; display &lt;= "00000000";
            end case;
        end if;
    end process;
end architecture bhv;</vhdl>
